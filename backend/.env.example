PORT=5000

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
ADMIN_WHATSAPP=919XXXXXXXXX
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/advocate_chauhan?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_key_min_32_chars
JWT_EXPIRE=7d
NODE_ENV=development
ADMIN_EMAIL=admin@advocatechauhan.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Admin
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Razorpay (also configurable from Admin Panel → Site Settings → Payment)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Email (nodemailer — for receipt delivery)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
