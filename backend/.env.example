PORT=5000

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
ADMIN_WHATSAPP=919XXXXXXXXX
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/advocate_chauhan?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_key_min_32_chars
JWT_EXPIRE=7d
NODE_ENV=development
ADMIN_EMAIL=admin@advocatechauhan.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Admin
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Single-device session enforcement (see backend/middleware/userAuth.js) — how long
# a user's session stays "claimed" with no activity before another device may log in.
USER_SESSION_TIMEOUT_MINUTES=60
# How long a course-video streaming token stays valid once issued (see
# backend/utils/videoAccess.js) — long enough to cover a full lecture without
# needing to re-authenticate mid-playback.
VIDEO_TOKEN_EXPIRE=4h


# Email (nodemailer — for receipt delivery)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
